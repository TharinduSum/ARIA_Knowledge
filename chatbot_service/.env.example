# DB Pool Settings
DB_MIN_SIZE=2
DB_MAX_SIZE=10

# Ollama AI Configuration
OLLAMA_URL=http://192.168.10.10:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=llama3.2

# Vector Search Default Limit
DEFAULT_TOP_K=5
